{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://essenceofvirality.local/schemas/extraction-report.schema.json",
  "title": "ExtractionReport",
  "description": "Structured notes from the source-extraction agent. Preserves who said what; never treats extracted text as verified truth.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "type": "object",
  "properties": {
    "artifact_type": { "const": "extraction_report" },
    "source_id": { "$ref": "common.schema.json#/$defs/artifactId" },
    "method": { "type": "string", "description": "How content was obtained (fetch, pasted transcript, PDF text layer, manual)." },
    "limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Extraction failures and gaps. Never hidden."
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "section_id": { "type": "string" },
          "heading": { "type": "string" },
          "summary": { "type": "string" },
          "content_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "author_statement", "quoted_third_party", "data", "method",
                "result", "recommendation", "advertising_claim", "speculation"
              ]
            },
            "minItems": 1
          },
          "key_points": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["section_id", "summary", "content_kinds"]
      }
    }
  },
  "required": ["artifact_type", "source_id", "method", "limitations", "sections"]
}
