{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://essenceofvirality.local/schemas/knowledge-change-proposal.schema.json",
  "title": "KnowledgeChangeProposal",
  "description": "A proposed change to canonical knowledge documents, applied only via PR.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "type": "object",
  "properties": {
    "artifact_type": { "const": "knowledge_change_proposal" },
    "target_documents": {
      "type": "array",
      "items": { "type": "string", "pattern": "^knowledge/" },
      "minItems": 1
    },
    "change_type": { "type": "string", "enum": ["add", "revise", "dispute", "supersede"] },
    "summary": { "type": "string" },
    "claim_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/artifactId" },
      "minItems": 1,
      "description": "Every knowledge change must cite claims."
    },
    "diff_summary": { "type": "string", "description": "Human-readable description of what changes in each document." },
    "requires_creator_review": { "type": "boolean" }
  },
  "required": ["artifact_type", "target_documents", "change_type", "summary", "claim_ids", "requires_creator_review"]
}
