{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://essenceofvirality.local/schemas/evaluation-report.schema.json",
  "title": "EvaluationReport",
  "description": "Output of the evaluation agent: structural checks, fixture runs, regressions, and an explicit statement of what cannot be validated without real TikTok data.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "type": "object",
  "properties": {
    "artifact_type": { "const": "evaluation_report" },
    "subject_type": { "type": "string", "enum": ["skill_change", "knowledge_change", "source_ingestion", "schema_change"] },
    "subject_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/artifactId" },
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["structural", "instruction_quality", "fixture", "regression"] },
          "result": { "type": "string", "enum": ["pass", "fail", "warning", "not_applicable"] },
          "details": { "type": "string" }
        },
        "required": ["name", "kind", "result"]
      }
    },
    "fixtures_run": { "type": "array", "items": { "type": "string" } },
    "regressions_found": { "type": "array", "items": { "type": "string" } },
    "cannot_validate_without_real_data": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Honest boundary: what only real TikTok performance can confirm."
    },
    "overall": { "type": "string", "enum": ["pass", "pass_with_warnings", "fail"] },
    "recommendation": {
      "type": "string",
      "enum": ["merge", "revise", "hypothesis_only", "run_experiment", "reject"]
    }
  },
  "required": ["artifact_type", "subject_type", "subject_ids", "checks", "cannot_validate_without_real_data", "overall", "recommendation"]
}
