# Copy to .env and fill in locally. Never commit .env (gitignored).
# Phase one requires NO credentials; these are documented for later phases.

# --- Phase 2+ (research ingestion, optional) ---
# Transcript/document services, if adopted (none required today)
# YOUTUBE_API_KEY=

# --- Phase 3+ (production via OpenMontage clone; keys live in the clone's own .env) ---
# OPENMONTAGE_CLONE_PATH=   # local path to the pinned OpenMontage clone

# --- Phase 5+ (analytics) ---
# TIKTOK_ANALYTICS_EXPORT_DIR=   # local directory for raw exports (kept out of git)
